                              },
                              {
                                searchFor: /{rank}/g,
                                replaceWith: `Not found`,
                              },
                            ],
                          });
                          embed.ephemeral = true;
                          await c.editReply(embed);
                        }
                      });
                    }
                  }
                });
              }
            });
          }
        }
