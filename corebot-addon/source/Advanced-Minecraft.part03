          thumbnail:
                (Config?.Messages?.Synchronized_Account?.Syncing?.Thumbnail ??
                  false) === false
                  ? undefined
                  : Config.Messages.Synchronized_Account.Thumbnail,
              image:
                (Config?.Messages?.Synchronized_Account?.Image ?? false) ===
